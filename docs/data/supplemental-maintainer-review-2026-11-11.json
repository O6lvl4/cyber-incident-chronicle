      "checkedAt": "2026-11-10T21:18:36.870743Z",
      "status": "verified_release_and_crate_mapping_added",
      "error": "HTTP Error 404: Not Found",
      "advisoryApiStatus": "HTTP404",
      "osvId": "RUSTSEC-2026-0459",
      "sourceChecks": [
        {
          "url": "https://api.github.com/repos/rusqlite/rusqlite/releases/tags/v0.41.0",
          "httpStatus": 200,
          "checkedAt": "2026-11-10T21:21:23.269620Z",
